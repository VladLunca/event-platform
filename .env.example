# Copy this file to .env and fill in your values before running docker-compose.
# cp .env.example .env

# ── Auth Service DB ─────────────────────────────────────────────
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=change_me
AUTH_DB_ROOT_PASSWORD=change_me_root
AUTH_DB_PORT=3306

# ── Event Service DB ────────────────────────────────────────────
EVENT_DB_NAME=event_db
EVENT_DB_USER=event_user
EVENT_DB_PASSWORD=change_me
EVENT_DB_ROOT_PASSWORD=change_me_root
EVENT_DB_PORT=3307

# ── Client Service DB (MongoDB) ─────────────────────────────────
CLIENT_DB_NAME=client_db
CLIENT_DB_USER=client_user
CLIENT_DB_PASSWORD=change_me
CLIENT_DB_PORT=27017

# ── JWT ─────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 32
JWT_SECRET=replace_with_a_strong_random_hex_secret
JWT_EXPIRATION_MS=86400000

# ── Seeded admin account ─────────────────────────────────────────
ADMIN_EMAIL=admin@platform.com
ADMIN_PASSWORD=change_me_admin

# ── Token blacklist store (Redis) ───────────────────────────────
REDIS_PORT=6379
